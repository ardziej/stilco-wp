msgid "Enter your Fakturownia API Token (from Fakturownia Settings → Account Settings → Integration → API Authorization Code)."
msgstr "Wprowadź swój Token API Fakturownia (z Fakturownia Ustawienia → Ustawienia konta → Integracja → Kod autoryzacji API)."

msgid "Enter your Fakturownia subdomain (e.g., if your URL is https://example.fakturownia.pl/, enter \"example\")."
msgstr "Wprowadź swoją subdomenę Fakturownia (np. jeśli Twój URL to https://example.fakturownia.pl/, wprowadź \"example\")."

