msgstr "Domyślna stawka ryczałtu. Można to nadpisać dla każdego produktu."

msgid "VIES VAT Validation (EU)"
msgstr "Walidacja VAT VIES (UE)"

msgid "Validate VAT numbers in EU VIES database. This allows verification of VAT numbers from EU countries."
msgstr "Waliduj numery VAT w bazie danych VIES UE. Pozwala to na weryfikację numerów VAT z krajów UE."

msgid "Enable VIES Validation"
msgstr "Włącz walidację VIES"

msgid "Validate VAT numbers using EU VIES database"
msgstr "Waliduj numery VAT używając bazy danych VIES UE"

msgid "When enabled, VAT numbers from EU countries will be validated against the VIES database during checkout."
msgstr "Po włączeniu, numery VAT z krajów UE będą walidowane w bazie danych VIES podczas realizacji zamówienia."

msgid "Invalid VAT Handling"
msgstr "Obsługa nieprawidłowego VAT"

msgid "Reject order and show error"
msgstr "Odrzuć zamówienie i pokaż błąd"

msgid "Accept order"
msgstr "Zaakceptuj zamówienie"

msgid "How to handle orders with invalid VAT numbers."
msgstr "Jak obsługiwać zamówienia z nieprawidłowymi numerami VAT."

msgid "Document Type (No VAT)"
msgstr "Typ dokumentu (bez VAT)"

msgid "Bill (Rachunek)"
msgstr "Rachunek"

msgid "Invoice Without VAT (Faktura bez VAT)"
msgstr "Faktura bez VAT"

